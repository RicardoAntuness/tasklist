# Node 18 Alpine: imagem oficial LTS com footprint reduzido (~50MB vs ~900MB full).
# Garante a estabilidade de uma versão de suporte a longo prazo e diminui 
# drasticamente o tamanho final do container e a superfície de vulnerabilidades.
FROM node:18-alpine

# Define o diretório padrão para os comandos seguintes dentro do container.
# Cria um espaço isolado (/app), evitando conflitos com arquivos do sistema base.
WORKDIR /app

# Copia apenas o manifesto primeiro - permite que o Docker reutilize o cache
# das dependências quando só o código-fonte muda.
# Isso otimiza o tempo de build pois pula a instalação caso o package.json não mude.
COPY package*.json ./

# Instala as dependências necessárias de forma isolada dentro da camada do container.
RUN npm install

# Copia o restante do código-fonte (incluindo server.js e a pasta public/).
# Fica após o npm install para que alterações no HTML ou JS não invalidem o cache do RUN.
COPY . .

# Documenta a porta usada pela aplicação (não abre a porta por si só).
# Atua como metadado para o desenvolvedor e para o mapeamento do Docker Compose.
EXPOSE 3000

# CMD é substituível em runtime; ENTRYPOINT seria fixo - escolha consciente.
# Utiliza o script "start" mapeado no package.json para iniciar o servidor Node.js.
CMD ["npm", "start"]